#!/bin/sh
# Tell the model which option-group prefix to use next, derived from the
# transcript rather than from memory — a model can't reliably recall which
# letters it already spent 200 turns ago, and a reused prefix silently breaks
# the one guarantee unique-option-numbering makes.
#
# Only IDs written in the shapes the rule mandates count (**C1**, "| C1", "- C1",
# "(C1)"). Over-counting is harmless — it burns a letter — while under-counting
# collides, so the patterns lean inclusive.
#
# Reads the transcript newest-first and stops at this hook's own last output:
# that prefix is already one past every ID written before it, so only the turn
# since then can raise it. A full scan only happens when there is no checkpoint
# yet (a new session, or a hook run that timed out and left none).
#
# Runs on every prompt, so it stays at two processes (reverse + jq) under a
# plain sh: a spawn can cost 30-250ms under endpoint security, and
# `/usr/bin/env bash` alone costs twice what /bin/sh does to start.
set -u

# Hook input is one line of JSON; pull the path with parameter expansion
# rather than spawning a parser for it.
IFS= read -r input
case $input in *'"transcript_path"'*) ;; *) exit 0 ;; esac
transcript=${input#*\"transcript_path\"}
transcript=${transcript#*\"}
transcript=${transcript%%\"*}
[ -r "$transcript" ] || exit 0

reverse() { if command -v tac >/dev/null; then tac "$1"; else tail -r "$1"; fi; }

# Model prose only: tool-call inputs ride in the same assistant message, so a
# bash command or a diff mentioning S3 or B2 would otherwise burn letters.
# Prefixes are bijective base-26 (A=1, Z=26, AA=27); no IDs yet yields A.
reverse "$transcript" | jq -Rrn '
  def num: reduce explode[] as $c (0; . * 26 + $c - 64);
  def checkpoint: select(.type == "attachment" and .attachment.hookEvent == "UserPromptSubmit")
    | .attachment.content // "" | capture("^Next option-group prefix: (?<p>[A-Z]+)\\.").p | num;
  def ids: select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text
    | scan("(?:^|[^A-Za-z0-9_])([A-Z]{1,3})[0-9]+(?:\\*\\*|[ ]*[·—:)|,]|$)") | .[0] | num + 1;
  label $out
  | foreach ((inputs | fromjson?), null) as $v ({next: 1};
      if $v == null then .done = true
      else ([$v | checkpoint] | first) as $c
        | if $c then .next = ([.next, $c] | max) | .done = true
          else .next = ([.next, ($v | ids)] | max) end
      end;
      if .done then .next, break $out else empty end)
  | [ recurse(if . > 0 then (. - 1) / 26 | floor else empty end) | select(. > 0) | (. - 1) % 26 + 65 ]
  | reverse | implode as $p
  | "Next option-group prefix: \($p). Any options, choices, or examples you present this turn are \($p)1, \($p)2, … (see unique-option-numbering)."
' 2>/dev/null
