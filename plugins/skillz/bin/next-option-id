#!/usr/bin/env bash
# Tell the model which option-group prefix to use next, derived from the
# transcript rather than from memory — a model can't reliably recall which
# letters it already spent 200 turns ago, and a reused prefix silently breaks
# the one guarantee unique-option-numbering makes.
#
# Only IDs written in the shapes the rule mandates count (**C1**, "| C1", "- C1",
# "(C1)"). Over-counting is harmless — it burns a letter — while under-counting
# collides, so the patterns lean inclusive.
#
# Runs on every prompt, so bash parses stdin with builtins and execs a single jq:
# a process spawn can cost 30-250ms under endpoint security, and the old
# per-prefix subshells hit the 30s hook timeout.
set -uo pipefail

IFS= read -rd '' input
[[ $input =~ \"transcript_path\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]] || exit 0
transcript=${BASH_REMATCH[1]}
[ -r "$transcript" ] || exit 0

# Model prose only: tool-call inputs ride in the same assistant message, so a
# bash command or a diff mentioning S3 or B2 would otherwise burn letters.
# Prefixes are bijective base-26 (A=1, Z=26, AA=27); no IDs yet yields A.
exec jq -Rrn '
  [ inputs | fromjson? | select(.type == "assistant") | .message.content[]?
    | select(.type == "text") | .text
    | scan("(?:^|[^A-Za-z0-9_])([A-Z]{1,2})[0-9]+(?:\\*\\*|[ ]*[·—:)|,]|$)") | .[0]
    | reduce explode[] as $c (0; . * 26 + $c - 64) ]
  | (max // 0) + 1
  | [ recurse(if . > 0 then (. - 1) / 26 | floor else empty end) | select(. > 0) | (. - 1) % 26 + 65 ]
  | reverse | implode as $p
  | "Next option-group prefix: \($p). Any options, choices, or examples you present this turn are \($p)1, \($p)2, … (see unique-option-numbering)."
' "$transcript" 2>/dev/null
