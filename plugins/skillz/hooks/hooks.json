{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(uname)\" != Darwin ] || [ \"${CLAUDE_CODE_ENTRYPOINT:-}\" = t3-code ] || cat \"${CLAUDE_PLUGIN_ROOT}/context/copy-links.md\""
          },
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_ENTRYPOINT:-}\" != t3-code ] || sed \"s#\\${CLAUDE_PLUGIN_ROOT}#${CLAUDE_PLUGIN_ROOT}#g\" \"${CLAUDE_PLUGIN_ROOT}/context/t3-formatting.md\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sync-rules\""
          },
          {
            "type": "command",
            "command": "[ \"$(uname)\" != Darwin ] || \"${CLAUDE_PLUGIN_ROOT}/bin/install-pbcopy-uri-handler\" >/dev/null"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sync-rules\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/next-option-id\""
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(uname)\" != Darwin ] || \"${CLAUDE_PLUGIN_ROOT}/bin/install-pbcopy-uri-handler\"",
            "statusMessage": "skillz: installing pbcopy:// URI handler"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/block-no-verify\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/block-plain-pr-base\""
          }
        ]
      }
    ]
  },
  "modules": ["./register.tsx"]
}
