{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(uname)\" != Darwin ] || cat \"${CLAUDE_PLUGIN_ROOT}/context/copy-links.md\""
          },
          {
            "type": "command",
            "command": "{ set -- \"${CLAUDE_PLUGIN_ROOT}\"/rules/*.md; [ -e \"$1\" ] && { mkdir -p \"${HOME}/.claude/rules\"; for f in \"$@\"; do cp -f \"$f\" \"${HOME}/.claude/rules/skillz-$(basename \"$f\")\"; done; }; } >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(uname)\" != Darwin ] || \"${CLAUDE_PLUGIN_ROOT}/bin/install-pbcopy-uri-handler\"",
            "statusMessage": "skillz: installing pbcopy:// URI handler"
          }
        ]
      }
    ]
  }
}
